# Copy to .env and fill in for local dev. Never commit the real .env.

# --- Database (matches scripts/setup_local_db.sh defaults) ---
DATABASE_URL=postgresql://tic:tic@localhost:5432/tic

# --- JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS: origins allowed to call the API (the static frontend dev server) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Desktop agent (only needed on the machine running agent/src/main.py) ---
TICK_API_BASE_URL=http://localhost:8000/api/v1
TICK_AGENT_EMAIL=employee.a@acme.test
TICK_AGENT_PASSWORD=devpassword123
TICK_DEVICE_NAME=DESKTOP-001
TICK_AGENT_VERSION=0.1.0
